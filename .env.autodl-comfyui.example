# AutoDL ComfyUI 应用镜像自带的目录。
H3_COMFYUI_DIR=/root/ComfyUI
H3_COMFYUI_INPUT_DIR=/root/ComfyUI/input
H3_COMFYUI_OUTPUT_DIR=/root/ComfyUI/output
H3_COMFYUI_URL=http://127.0.0.1:6008

# 工作台任务数据和生成结果保存在数据盘。
H3_STUDIO_DATA_DIR=/root/autodl-tmp/h3-studio-data

# AutoDL 公共模型软链接在 ComfyUI 中显示的文件名。
H3_COMFYUI_UNET=minimax_h3_ref2va_pruned_int8_convrot.safetensors
H3_COMFYUI_CLIP=qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors
H3_COMFYUI_VIDEO_VAE=minimax_h3_video_vae_int8_convrot.safetensors
H3_COMFYUI_AUDIO_VAE=minimax_h3_audio_vae_fp32.safetensors

H3_COMFYUI_TIMEOUT=10800
H3_MAX_UPLOAD_GB=20
