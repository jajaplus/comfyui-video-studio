# AutoDL 数据盘目录，实例关机后仍保留任务和成片。
H3_STUDIO_DATA_DIR=/root/autodl-tmp/h3-studio-data

# 本机 ComfyUI。后端通过 6008 端口提交生成任务。
H3_COMFYUI_URL=http://127.0.0.1:6008
H3_COMFYUI_DIR=/root/autodl-tmp/ComfyUI
H3_COMFYUI_INPUT_DIR=/root/autodl-tmp/ComfyUI/input
H3_COMFYUI_OUTPUT_DIR=/root/autodl-tmp/ComfyUI/output

# uv 下载缓存放在数据盘；安装中断后重新执行可以继续复用。
H3_UV_CACHE_DIR=/root/autodl-tmp/.cache/uv

# Wan VACE 精准商品重绘模型。文件需放在对应的 ComfyUI models 子目录。
VACE_UNET=wan2.1_vace_14B_fp16.safetensors
VACE_CLIP=umt5_xxl_fp8_e4m3fn_scaled.safetensors
VACE_VAE=wan_2.1_vae.safetensors
# AutoDL 模型广场公共路径；模型挂载脚本默认使用这些文件，不复制、不下载。
VACE_UNET_PUBLIC_PATH=/.autodl/e8/9f/11/e89f11d81110d363b9fde6e921e802b7
VACE_CLIP_PUBLIC_PATH=/.autodl/4b/ad/50/4bad5031eb889beddcfb6e1b9b12cccc
VACE_VAE_PUBLIC_PATH=/.autodl/0d/d0/84/0dd084bcf4728fe874a9e3b18110af74
VACE_MASK_EXPAND=12
VACE_CFG=5
VACE_COMFYUI_WORKFLOW=/root/autodl-tmp/comfyui-video-studio/workflows/wan_vace_inpaint_api.json

# 单条 ComfyUI 任务最长等待时间（秒）。
H3_COMFYUI_TIMEOUT=10800

# 精准局部替换工具。运行 scripts/install_precision_tools.sh 后无需修改。
H3_PRECISION_TOOLS_DIR=/root/autodl-tmp/h3-precision-tools
# 独立新版 FFmpeg，FaceFusion 视频处理需要 -fps_mode；运行 scripts/install_ffmpeg.sh 安装。
H3_FFMPEG_ENV=/root/autodl-tmp/h3-precision-tools/ffmpeg-env
H3_SAM2_PYTHON=/root/autodl-tmp/h3-precision-tools/sam2-env/bin/python
H3_SAM2_MODEL_ID=facebook/sam2.1-hiera-small
H3_SAM2_CHECKPOINT=/root/autodl-tmp/h3-precision-tools/models/sam2.1_hiera_small.pt
H3_SAM2_CONFIG=configs/sam2.1/sam2.1_hiera_s.yaml
# 商品自动识别模型；安装脚本默认下载到下面目录，也可填写 AutoDL 公共模型目录。
H3_FLORENCE2_MODEL=/root/autodl-tmp/h3-precision-tools/models/Florence-2-base-ft
H3_FLORENCE2_MODEL_ID=microsoft/Florence-2-base-ft
# AutoDL 公共模型可以是完整目录或单个 safetensors 权重文件；留空则联网下载。
H3_FLORENCE2_PUBLIC_PATH=
# 只有公共路径缺少配置文件时才会联网；默认 60 秒超时，不会无限等待。
H3_HF_ENDPOINT=https://hf-mirror.com
H3_HF_DOWNLOAD_TIMEOUT=60
H3_FACEFUSION_DIR=/root/autodl-tmp/h3-precision-tools/facefusion
H3_FACEFUSION_PYTHON=/root/autodl-tmp/h3-precision-tools/facefusion-env/bin/python
H3_FACEFUSION_VERSION=3.9.0
# 提高小脸、侧脸检测率，并加强参考脸身份；通常不需要修改。
H3_FACEFUSION_DETECTOR_SCORE=0.25
H3_FACEFUSION_LANDMARKER_SCORE=0.25
H3_FACEFUSION_SWAPPER_WEIGHT=0.85
H3_FACEFUSION_LOG_DIR=/root/autodl-tmp/comfyui-video-studio/logs/facefusion
# AutoDL 有 FaceFusion 公共模型时，填写包含 ONNX 文件的公共目录；留空则只下载缺少文件。
H3_FACEFUSION_MODELS_DIR=
# GitHub Release 下载不稳定时可填写代理前缀；下载默认重试 8 次并保留断点。
H3_GITHUB_PROXY=
H3_FACEFUSION_DOWNLOAD_RETRIES=8

# 单文件上传上限（GB）。
H3_MAX_UPLOAD_GB=20
