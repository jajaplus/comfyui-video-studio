# 网页访问令牌。部署到公网时务必改成随机长字符串。
H3_STUDIO_TOKEN=change-this-to-a-long-random-token

# AutoDL 数据盘目录，实例关机后仍保留任务和成片。
H3_STUDIO_DATA_DIR=/root/autodl-tmp/h3-studio-data

# 本机 SGLang Ref2VA 服务。
H3_ENGINE_URL=http://127.0.0.1:30011

# 单文件上传上限（GB）。
H3_MAX_UPLOAD_GB=20

# 可选：允许 Excel 引用服务器上已存在的素材，但只能读取该目录内部。
# H3_SERVER_ASSET_ROOT=/root/autodl-tmp/media

